# =============================================================================
# Lumin OS 开发环境配置示例
# 复制为 .env 后直接 ``uv run hugagent serve`` 即可单机启动。
# 注释掉的字段表示 cli.py 已提供 dev profile 默认值 —— 删/留空都能跑。
# 真正要改的只有：版本、SSO 模式、mock 用户。
# =============================================================================

# ── 版本 ─────────────────────────────────────────────────────────────────────
JX_EDITION=ee

# ── 品牌（可自定义；协议要求保留 Powered-by 标识） ───────────────────────────
BRAND_PRODUCT_NAME=LuminOS
BRAND_ORG_NAME=

# ── 数据库 ──────────────────────────────────────────────────────────────────
# dev profile 默认走 SQLite（~/.hugagent/data.db），不必写；要连 Postgres 时
# 解开下一行，并把 POSTGRES_* 改成实际账号；容器化部署另见 compose profile。
# DATABASE_URL=postgresql+psycopg2://hugagent:hugagent@localhost:5432/hugagent
# POSTGRES_USER=hugagent
# POSTGRES_PASSWORD=hugagent
# POSTGRES_DB=hugagent
# POSTGRES_HOST_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# dev profile 默认空 → 走 in-process event stream（core.infra.ephemeral），
# 不需要本机装 Redis。要走真 Redis 时解开下一行。
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST_PORT=6379

# ── 认证 ────────────────────────────────────────────────────────────────────
# dev 默认 mock 自动登录：浏览器首次访问即获得 AUTH_MOCK_USER_ID 对应的会话。
# 想走本地账密登录页 / 容器化 SSO 时改成 local / remote。
AUTH_MODE=session
SSO_LOGIN_MODE=mock
AUTH_MOCK_USER_ID=dev_user_001

# ── 存储（dev profile 默认 local + ~/.hugagent/storage） ───────────────────
STORAGE_TYPE=local
# HOST_STORAGE_PATH=./data/storage

# ── Web 构建默认值 ──────────────────────────────────────────────────────────
# VITE_EDITION 必须与 JX_EDITION 一致，否则首屏会按错误版本渲染再切回，造成
# 视觉闪烁。VITE_API_BASE_URL 留空 → 走 Vite dev proxy（/api → :3001）。
VITE_EDITION=ee
VITE_DEFAULT_LANGUAGE=en
VITE_API_BASE_URL=
# VITE_USE_MOCK=true

# ── 沙箱（dev profile 默认 script_runner；连容器时改 service 名） ───────────
# SANDBOX_PROVIDER=script_runner
# SANDBOX_RUNNER_URL=http://localhost:8900
# SANDBOX_ARTIFACT_MAX_BYTES=104857600

# ── 记忆（L1 画像默认开箱；L2 mem0 / L3 Neo4j 需独立部署） ────────────────
# MEM0_ENABLED=true

# ── 服务端口（dev profile 默认 3001/3002） ──────────────────────────────────
# BACKEND_PORT=3001
# FRONTEND_PORT=3002

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
